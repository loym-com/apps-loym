<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="enable_banking_fetch_wizard_form" model="ir.ui.view">
        <field name="name">enable.banking.fetch.wizard.form</field>
        <field name="model">enable.banking.fetch.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
                <footer>
                    <button name="action_fetch" string="Fetch" type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

     <record id="action_enable_banking_fetch_wizard" model="ir.actions.act_window">
        <field name="name">Enable Banking Fetch Wizard</field>
        <field name="res_model">enable.banking.fetch.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" eval="False" />
        <field name="binding_view_types" eval="False" />
    </record>

</odoo>
