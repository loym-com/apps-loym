<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_nets_recurring" model="ir.ui.view">
        <field name="name">Payment Provider Form - Nets Recurring</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'nets'">
                    <field name="nets_support_recurring"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
