<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_rate_menu_list" model="ir.ui.view">
        <field name="name">res.currency.rate.list.currency.rate.menu</field>
        <field name="model">res.currency.rate</field>
        <field name="arch" type="xml">
            <list string="Currency Rates">
                <field name="name" />
                <field name="currency_id" />
                <field name="company_id" />
                <field name="rate" />
            </list>
        </field>
    </record>

    <record id="view_currency_rate_menu_search" model="ir.ui.view">
        <field name="name">res.currency.rate.search.currency.rate.menu</field>
        <field name="model">res.currency.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="currency_id" />
                <filter
                    name="active_currencies"
                    string="Active Currencies"
                    domain="[('currency_id.active', '=', True)]"
                />
                <filter
                    name="today_rates"
                    string="Today's Rates"
                    domain="[('name', '=', context_today().strftime('%Y-%m-%d'))]"
                />
            </search>
        </field>
    </record>

    <record id="action_currency_rate_menu" model="ir.actions.act_window">
        <field name="name">Currency Rates</field>
        <field name="res_model">res.currency.rate</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_currency_rate_menu_list" />
        <field name="search_view_id" ref="view_currency_rate_menu_search" />
    </record>

    <menuitem
        id="menu_currency_rate_menu"
        name="Currency Rates"
        parent="account.account_account_menu"
        action="action_currency_rate_menu"
        sequence="6"
    />
</odoo>