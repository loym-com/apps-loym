<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_read_me_list" model="ir.ui.view">
        <field name="name">x_read.me.list</field>
        <field name="model">x_read.me</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="README">
                <field name="x_name" />
                <field name="x_active" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_x_read_me_form" model="ir.ui.view">
        <field name="name">x_read.me.form</field>
        <field name="model">x_read.me</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="README">
                <sheet>
                    <field name="x_active" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" placeholder="Title" />
                        </h1>
                    </div>
                    <group>
                        <field name="x_company_id" options="{'no_create': True}" />
                    </group>
                    <field name="x_readme" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_x_read_me_search" model="ir.ui.view">
        <field name="name">x_read.me.search</field>
        <field name="model">x_read.me</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name" />
                <field name="x_company_id" />
                <filter name="archived" string="Archived"
                    domain="[('x_active', '=', False)]" context="{'active_test': False}" />
            </search>
        </field>
    </record>
</odoo>
