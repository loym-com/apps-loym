<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_read_me_list" model="ir.ui.view">
        <field name="name">x_read.me.list</field>
        <field name="model">x_read.me</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="README">
                <field name="x_name" />
            </list>
        </field>
    </record>

    <record id="view_x_read_me_form" model="ir.ui.view">
        <field name="name">x_read.me.form</field>
        <field name="model">x_read.me</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="README">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" placeholder="Title" />
                        </h1>
                    </div>
                    <field name="x_readme" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>
</odoo>
