<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="privilege_offering" model="res.groups.privilege">
        <field name="name">Offering</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_offering_user" model="res.groups">
        <field name="name">Offering user</field>
        <field name="privilege_id" ref="privilege_offering"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="access_offering_account" model="ir.access">
        <field name="name">Offering accounts</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="group_id" ref="group_offering_user"/>
        <field name="operation">r</field>
    </record>
    <record id="access_offering_account_tag" model="ir.access">
        <field name="name">Offering account tags</field>
        <field name="model_id" ref="account.model_account_account_tag"/>
        <field name="group_id" ref="group_offering_user"/>
        <field name="operation">r</field>
    </record>
    <record id="access_offering_move" model="ir.access">
        <field name="name">Offering journal entries</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="group_id" ref="group_offering_user"/>
        <field name="operation">crud</field>
        <field name="domain" eval="str([('journal_id', '=', ref('journal_offering'))])"/>
    </record>
    <record id="access_offering_move_line" model="ir.access">
        <field name="name">Offering journal items</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="group_id" ref="group_offering_user"/>
        <field name="operation">crud</field>
        <field name="domain" eval="str([('journal_id', '=', ref('journal_offering'))])"/>
    </record>
    <record id="access_offering_journal" model="ir.access">
        <field name="name">Offering journal</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="group_id" ref="group_offering_user"/>
        <field name="operation">r</field>
        <field name="domain" eval="str([('id', '=', ref('journal_offering'))])"/>
    </record>
</odoo>
